{
  "name": "bangmio",
  "version": "4.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "db:local:init": "node scripts/db-local-init.mjs",
    "dev:server": "node --watch server/src/index.js",
    "server:start": "node server/src/index.js",
    "dev:all": "concurrently -n server,next -c yellow,cyan \"npm:dev:server\" \"npm:dev:next\"",
    "build": "opennextjs-cloudflare build",
    "server:build": "npx esbuild server/src/app.js --bundle --platform=node --format=esm --outfile=functions/api/_server.js --metafile=functions/api/_meta.json",
    "bundle:size": "node scripts/bundle-size.mjs",
    "postinstall": "npm ci --prefix client && npm ci --prefix tooling/eslint --ignore-scripts --install-strategy=nested",
    "prepare": "husky",
    "lint": "npm run lint:vue && npm run lint:react && npm run typecheck",
    "lint:fix": "npm run lint:vue -- --fix && npm run lint:react -- --fix",
    "format": "prettier --write \"**/*.{js,vue,json,css,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:notes": "node scripts/release-notes.mjs",
    "dev:next": "next dev -p 3001",
    "next:build": "next build",
    "typecheck": "tsc --noEmit",
    "next:start": "next start",
    "next:open": "npm run build",
    "next:deploy": "npm run build && wrangler deploy",
    "dev:vue": "npm run dev --prefix client",
    "build:vue": "npm run build --prefix client",
    "lint:vue": "eslint . --ext .js,.vue",
    "next:dry-run": "npm run build && wrangler deploy --dry-run",
    "lint:react": "eslint app components lib --ext .ts,.tsx --no-eslintrc --config .eslintrc.react.cjs --max-warnings=0",
    "check": "npm run lint && npm test && npm run next:build"
  },
  "devDependencies": {
    "@hono/node-server": "^1.17.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-vue": "^9.27.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "vue": "^3.5.34",
    "wrangler": "^4.131.0"
  },
  "dependencies": {
    "hono": "^4.12.27",
    "linkedom": "^0.18.12",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --no-eslintrc --config .eslintrc.react.cjs --max-warnings=0",
      "prettier --write"
    ]
  },
  "releaseName": "Bangmio",
  "repository": {
    "type": "git",
    "url": "https://github.com/sparkmio/Bangmio"
  }
}
