# 前端环境变量（Vite）
# 复制此文件为 .env 并填入实际值
# 文档：https://vitejs.dev/guide/env-and-mode.html

# API 基础 URL（可选；缺省时代码回退到相对路径 /api/v1）
# 注意：变量名必须与 src/api/index.js 中读取的 VITE_API_BASE 一致
VITE_API_BASE=/api/v1

# Cloudflare Turnstile 公钥（可选；后端开启验证时填写）
VITE_TURNSTILE_SITE_KEY=

# 注册页是否展示邮箱验证码流程，按后端能力设置
VITE_REQUIRE_EMAIL_CODE=false
